{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lodestar",
  "version": "0.5.0",
  "identifier": "app.lodestar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lodestar",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2OTRGRTkzRDIzNDgwQTMKUldTamdEVFNrLzZVbHIvN0FkMUpNOWxRM2lza1VCZ1dpaFZydDQzTHU3dDFVemlOai96YnFmUmkK",
      "endpoints": [
        "https://github.com/Seobuk/lodestar-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
